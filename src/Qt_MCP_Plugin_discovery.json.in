{
  "clientInstructions": "Call the getMethodMetadata tool first to obtain timeout values for methods such as loadSession, build, debug, and waitForBuildCompletion. Use the listTools tool or the MCP method tools/list to see all available tools.",
  "mcp": {
    "version": "2024-11-05",
    "name": "Qt Creator MCP Plugin",
    "description": "Model Context Protocol server for Qt Creator IDE integration",
    "version": "@PLUGIN_VERSION@",
    "author": "Qt MCP Plugin Team",
    "license": "MIT"
  },
  "server": {
    "name": "Qt MCP Plugin",
    "version": "@PLUGIN_VERSION@",
    "transport": "http",
    "host": "localhost",
    "port": 3001,
    "protocols": ["http", "tcp"],
    "capabilities": {
      "tools": {
        "listChanged": false
      }
    }
  },
  "tools": [
    {
      "name": "build",
      "description": "Build the current Qt Creator project"
    },
    {
      "name": "getBuildStatus", 
      "description": "Get current build progress and status"
    },
    {
      "name": "debug",
      "description": "Start debugging the current project"
    },
    {
      "name": "openFile",
      "description": "Open a file in Qt Creator",
      "parameters": {
        "path": {
          "type": "string",
          "description": "Path to the file to open",
          "required": true
        }
      }
    },
    {
      "name": "listProjects",
      "description": "List all available projects"
    },
    {
      "name": "listBuildConfigs",
      "description": "List available build configurations"
    },
    {
      "name": "switchBuildConfig",
      "description": "Switch to a specific build configuration",
      "parameters": {
        "name": {
          "type": "string",
          "description": "Name of the build configuration to switch to",
          "required": true
        }
      }
    },
    {
      "name": "runProject",
      "description": "Run the current project"
    },
    {
      "name": "cleanProject",
      "description": "Clean the current project"
    },
    {
      "name": "listOpenFiles",
      "description": "List currently open files"
    },
    {
      "name": "listSessions",
      "description": "List available sessions"
    },
    {
      "name": "loadSession",
      "description": "Load a specific session",
      "parameters": {
        "sessionName": {
          "type": "string",
          "description": "Name of the session to load",
          "required": true
        }
      }
    },
    {
      "name": "listIssues",
      "description": "List current issues (warnings and errors)"
    },
    {
      "name": "getBuildDiagnostics",
      "description": "Get structured build diagnostics (JSON array) for Cursor Problems panel"
    },
    {
      "name": "quit",
      "description": "Quit Qt Creator"
    },
    {
      "name": "getCurrentProject",
      "description": "Get the currently active project"
    },
    {
      "name": "getCurrentBuildConfig",
      "description": "Get the currently active build configuration"
    },
    {
      "name": "getCurrentSession",
      "description": "Get the currently active session"
    },
    {
      "name": "saveSession",
      "description": "Save the current session"
    },
    {
      "name": "listTools",
      "description": "List all available MCP tools. Same as the MCP tools/list method. Call this or tools/list to discover every tool including getMethodMetadata and listTools."
    },
    {
      "name": "getMethodMetadata",
      "description": "Get method metadata including timeout values for loadSession, build, debug, waitForBuildCompletion, etc. Call this first to discover timeout values."
    },
    {
      "name": "setMethodMetadata",
      "description": "Set timeout value (seconds) for a method (e.g. loadSession, build, debug).",
      "parameters": {
        "method": {"type": "string", "description": "Method name (e.g. loadSession, build)"},
        "timeoutSeconds": {"type": "integer", "description": "Timeout in seconds"}
      }
    }
  ],
  "installation": {
    "platform": "@CMAKE_SYSTEM_NAME@",
    "installPath": "@CMAKE_INSTALL_PREFIX@",
    "pluginPath": "@QTCREATOR_PLUGINS_DIR@",
    "installedAt": "@CMAKE_CURRENT_BINARY_DIR@"
  },
  "discovery": {
    "file": "Qt_MCP_Plugin_discovery.json",
    "generated": true,
    "lastUpdated": "@CMAKE_CURRENT_LIST_FILE@"
  }
}
