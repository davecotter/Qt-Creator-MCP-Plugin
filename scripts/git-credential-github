#!/bin/sh
# Git credential helper: reads ~/.github/credentials.txt (no TTY needed).
# File format: username=... and personal_access_token=...
case "$1" in
  get)
    creds="${HOME}/.github/credentials.txt"
    [ -r "$creds" ] || exit 1
    while IFS= read -r line; do
      case "$line" in
        username=*) echo "username=${line#*=}";;
        personal_access_token=*) echo "password=${line#*=}";;
      esac
    done < "$creds"
    ;;
  *) exit 0 ;;
esac
